TEXT 176 32 Left 2 ;Acondicionador +/-10 V -> 0..5 V con LM399     Vout = 0,25*Vin + 2,5
TEXT 336 368 Left 2 ;ETAPA 1: BUFFER
TEXT 688 368 Left 2 ;ETAPA 2: ATENUADOR  Av = -10k/40k = -0,25
TEXT 1056 424 Left 2 ;ETAPA 3: el offset entra por la entrada NO inversora
TEXT 1056 448 Left 2 ;Vout = -(Rf3/R2)*OUT2 + VP*(1+Rf3/R2) = 0,25*Vin + 2*VP
